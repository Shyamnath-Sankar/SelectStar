# SelectStar .env — local development config.
#
# IMPORTANT: Do NOT put real API keys here. GitHub's secret scanner will
# block any push that contains a real key, and even if it didn't, committing
# secrets is bad practice.
#
# For local dev: copy this file to .env.local and fill in your real LLM_API_KEY there.
# For production: set LLM_API_KEY as a secret env var in the Render dashboard.
#
# The app falls back to a built-in LLM SDK when LLM_API_KEY is empty, so the
# app still works without a key — just with degraded LLM quality.

DATABASE_URL="file:../db/custom.db"

# LLM config — leave API_KEY empty for local dev (uses fallback SDK).
# For production, set this in the Render dashboard as a secret env var.
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
