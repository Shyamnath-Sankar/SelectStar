# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Keep .env tracked — user explicitly wants it in the repo so Render picks
# up the LLM_API_KEY + DATABASE_URL from the file. All other .env* variants
# (.env.local, .env.production, etc.) are still ignored.
!.env

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# SQLite binary databases (created by prisma db push + seed-demo.js).
# The user can re-create them locally with `bun run db:push && node scripts/seed-demo.js`.
# On Render, attach a Persistent Disk and set DATABASE_URL to an absolute
# path on the disk (see render.yaml).
db/*.db
db/*.db-shm
db/*.db-wal

# Classic-mode file uploads — created at runtime by /api/classic/upload.
# Persisted on the persistent disk in production; never commit them.
db/classic-uploads/

# Sandbox dev artefacts — not part of the actual project.
.zscripts/dev.pid
.zscripts/dev.log

# Build outputs / large binaries (don't bloat the repo).
download/*.zip
download/*.png

# Sandbox upload directory (where the user uploads files for me to read).
# IMPORTANT: anchored to repo root so it doesn't match src/app/api/classic/upload/
/upload/

# Sandbox infrastructure — never commit these
.zscripts/
Caddyfile
examples/
mini-services/
tests/
tool-results/
/download/
/upload/
